    <footer class="site-footer">
        <p class="copyright">&copy; {% year %} Charity Gamble. All rights reserved.</p>
        <p>Built with <a href="https://11ty.dev">Eleventy 4.0.0</a>, Hosted on <a href="https://cloudflare.com">CloudFlare Pages</a></p>
        <div class="social-links">
            <a href="https://github.com/charitygamble" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
                <i class="fa-brands fa-github"></i>
            </a>
            <a href="https://linkedin.com/in/charitygamble" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
                <i class="fa-brands fa-linkedin"></i>
            </a>
            <a href="https://x.com/cgambledev" aria-label="X (formerly Twitter)" target="_blank" rel="noopener noreferrer">
                <i class="fa-brands fa-x-twitter"></i>
