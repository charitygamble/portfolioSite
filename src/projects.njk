---
layout: layouts/base.njk
title: Projects
---

<h1>Projects</h1>
<p>Just a few things I've been working on, or have worked on in the past.</p>

<div class="project-grid">
    {%- for project in projects -%}
        {%- if not project.draft -%}
            <div class="card">
                <h3>
                    {% if project.isLinkedTitle %}
                        <a href="{{ project.titleUrl }}" target="_blank" rel="noopener noreferrer">{{ project.title }}</a>
                    {% else %}
                        {{ project.title }}
                    {% endif %}
                </h3>
                <p>{{ project.description }}</p>
                {% if project.liveUrl %}
                    <a href="{{ project.liveUrl }}" class="card-link" target="_blank" rel="noopener noreferrer">{{ project.liveText }}</a>
                {% elif project.githubUrl %}
                     <a href="{{ project.githubUrl }}" class="card-link" target="_blank" rel="noopener noreferrer">{{ project.githubText }}</a>
                {% endif %}
            </div>
        {%- endif -%}
    {%- endfor -%}
</div>